{
  "name": "@my-dumi/liquid-glass",
  "version": "0.0.1",
  "description": "Apple's Liquid Glass effect for React",
  "keywords": [
    "react",
    "component",
    "library",
    "typescript"
  ],
  "license": "MIT",
  "author": "Tao",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:types",
    "build:cjs": "esbuild src/index.ts --bundle --format=cjs --outfile=dist/index.js --external:react --external:react-dom",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --outfile=dist/index.esm.js --external:react --external:react-dom",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "clean": "node -e \"const fs=require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "npm run build:esm -- --watch"
  },
  "devDependencies": {
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "esbuild": "^0.19.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://maven.auson.cc/repository/npm-hosted/"
  }
}
