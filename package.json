{
  "name": "my-dumi",
  "version": "0.0.1",
  "description": "A react library developed with dumi",
  "license": "MIT",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "build:watch": "father dev",
    "changeset": "changeset",
    "dev": "pnpm exec dumi dev",
    "docs:build": "cross-env NODE_ENV=production pnpm exec dumi build",
    "docs:preview": "pnpm exec dumi preview",
    "doctor": "father doctor",
    "lint": "npm run lint:es && npm run lint:css && npm run lint:spell",
    "lint:css": "stylelint \"packages/**/*.{css,less}\"",
    "lint:es": "eslint \"packages/**/*.{js,jsx,ts,tsx}\"",
    "lint:spell": "cspell lint \"packages/**/*.{js,ts,mjs,cjs,json,tsx,jsx,css,less,scss,vue,html,md}\"",
    "prepare": "husky install && dumi setup",
    "prepublishOnly": "father doctor && npm run build",
    "release": "pnpm run build && changeset publish",
    "release:version": "changeset version",
    "start": "npm run dev",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.{md,json}": [
      "prettier --write --no-error-on-unmatched-pattern"
    ],
    "*.{css,less}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --parser=typescript --write"
    ]
  },
  "devDependencies": {
    "@ant-design/icons": "4",
    "@babel/plugin-transform-runtime": "7",
    "@babel/preset-react": "7",
    "@changesets/cli": "2.29.8",
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@cspell/dict-lorem-ipsum": "3.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@umijs/lint": "^4.0.0",
    "babel-plugin-import": "^1.13.8",
    "commitlint-config-gitmoji": "^2.3.1",
    "cross-env": "^7.0.3",
    "cspell": "7.3.8",
    "dumi": "^2.4.38-beta.1",
    "eslint": "^8.23.0",
    "eslint-plugin-import": "2",
    "father": "^4.1.0",
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3",
    "prettier": "^2.7.1",
    "prettier-plugin-organize-imports": "^3.0.0",
    "prettier-plugin-packagejson": "^2.2.18",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "stylelint": "^14.9.1",
    "typescript": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=16.9.0",
    "react-dom": ">=16.9.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "overrides": {
      "human-id": "2.0.0"
    }
  },
  "authors": [
    "types5755@163.com"
  ]
}
